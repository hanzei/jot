# Environment variables for Jot
# Copy this file to .env and update the values

# Database connection string (SQLite file path or Postgres DSN)
JOT_DB_DSN=./jot.db

# Server port (optional, defaults to 8080)
JOT_PORT=8080

# Path to the compiled frontend static files (optional, defaults to ../webapp/build relative to the working directory)
# JOT_STATIC_DIR=/app/webapp/build

# Allowed CORS origin for the frontend (must be exact origin, not a wildcard)
# Required when frontend and backend are on different origins
# JOT_CORS_ALLOWED_ORIGIN=https://app.example.com

# Set to "false" to disable the Secure flag on session cookies (for local HTTP development)
# Defaults to "true" — always keep true in production (requires HTTPS)
JOT_COOKIE_SECURE=true

# Set to "false" to disable new user registration (admin can still create users via jotctl)
# Defaults to "true"
# JOT_REGISTRATION_ENABLED=false

# Minimum password length (1–72, defaults to 10)
# JOT_PASSWORD_MIN_LENGTH=10

# --- Metrics (Prometheus) ---

# Set to "true" to expose a Prometheus metrics endpoint
# JOT_METRICS_ENABLED=false

# Host and port for the Prometheus metrics endpoint (defaults to 127.0.0.1:8081)
# JOT_METRICS_HOST=127.0.0.1
# JOT_METRICS_PORT=8081

# --- OpenTelemetry ---
#
# There is no single on/off switch. OTel is set up whenever at least one of
# JOT_OTEL_TRACES_ENABLED, JOT_OTEL_METRICS_ENABLED, or JOT_OTEL_LOGS_ENABLED
# is "true"; each defaults to "false", so telemetry stays fully off until you
# opt in to at least one signal.

# OTLP gRPC collector endpoint. When unset, enabled signals fall back to
# stdout exporters instead (useful for local dev/debugging).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Set to "true" to connect to the OTLP endpoint without TLS (for local collectors)
# OTEL_EXPORTER_OTLP_INSECURE=false

# Headers sent with every OTLP request, e.g. for collector auth tokens.
# Comma-separated key=value pairs: "Authorization=Bearer <token>,X-Custom=value"
# Read directly by the OTel SDK, not by Jot itself — no Jot-specific config needed.
# OTEL_EXPORTER_OTLP_HEADERS=

# Service name reported in traces, metrics, and logs (defaults to "jot")
# OTEL_SERVICE_NAME=jot

# Set to "true" to export traces. Defaults to "false" — many collectors are
# only configured with metrics/logs pipelines, and exporting traces to one
# without a traces pipeline produces a steady stream of "Unimplemented"
# export error warnings.
# JOT_OTEL_TRACES_ENABLED=false

# Set to "true" to push metrics to the OTLP endpoint. Defaults to "false".
# Unrelated to JOT_METRICS_ENABLED above, which controls the separate
# Prometheus /metrics HTTP endpoint — that one is unaffected by this setting.
# JOT_OTEL_METRICS_ENABLED=false

# Set to "true" to export logs via OTLP/stdout. Defaults to "false".
# JOT_OTEL_LOGS_ENABLED=false
