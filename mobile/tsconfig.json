{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `noUnusedLocals` is the one webapp and shared have that this config does
    // not: 93 test files still carry an unused `import React`, left from before
    // the automatic JSX runtime. Turning it on is a follow-up, not a blocker.
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@jot/shared": ["../shared/src"],
      "@jot/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
